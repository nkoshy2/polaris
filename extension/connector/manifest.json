{
  "manifest_version": 3,
  "name": "Polaris Connector",
  "version": "0.2.1",
  "description": "Adds your Canvas and Gradescope assignments to Polaris as tasks, using your existing sign-in. Sends nothing anywhere else.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://canvas.illinois.edu/*",
    "https://www.gradescope.com/*",
    "https://nkoshy2.github.io/polaris/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://nkoshy2.github.io/polaris/*", "http://localhost:5173/*", "http://localhost:4173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
